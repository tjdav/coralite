{
  "name": "website",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjdav/coralite.git",
    "directory": "website"
  },
  "author": {
    "name": "Thomas David",
    "url": "https://thomasjackdavid.com"
  },
  "scripts": {
    "dev": "coralite dev",
    "start": "coralite dev",
    "build": "coralite build",
    "check": "coralite check",
    "fix": "coralite fix",
    "test:visual": "playwright test",
    "lint:css": "stylelint 'src/css/*.css'",
    "lint:css:fix": "stylelint --fix 'src/css/*.css'",
    "check:redirects": "node scripts/check-redirects.js",
    "topic-research": "node scripts/topic-research.js",
    "a11y:full": "pnpm build && A11Y_FULL=1 playwright test tests/__tests__/a11y-full.spec.js",
    "perf": "pnpm build && node scripts/perf.js",
    "perf:assert": "pnpm build && node scripts/perf.js --assert"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dotenvx/dotenvx": "^1.75.1",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solar-icons/js": "^2.3.4",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.5.0",
    "chrome-launcher": "^1.2.3",
    "coralite": "workspace:*",
    "dom-serializer": "^3.1.1",
    "highlight.js": "^11.12.0",
    "lighthouse": "^12.8.2",
    "postcss-import": "^16.1.1",
    "satori": "^0.12.2",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "fuse.js": "^7.5.0"
  },
  "stylelint": {
    "extends": "stylelint-config-twbs-bootstrap",
    "rules": {
      "declaration-block-single-line-max-declarations": null,
      "import-notation": "string",
      "property-no-vendor-prefix": null,
      "selector-class-pattern": null,
      "selector-max-type": null,
      "selector-no-qualifying-type": null,
      "@stylistic/value-list-comma-space-after": "always-single-line",
      "@stylistic/value-list-comma-newline-after": null
    }
  }
}

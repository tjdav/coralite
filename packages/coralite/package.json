{
  "name": "coralite",
  "version": "1.0.0-rc.0",
  "description": "Isomorphic Web Component framework for interactive SPAs and dynamic sites",
  "type": "module",
  "keywords": [
    "web-components",
    "isomorphic",
    "hydration",
    "spa",
    "ssr",
    "ssg",
    "components",
    "templates",
    "coralite",
    "site-engine"
  ],
  "homepage": "https://coralite.dev",
  "author": {
    "name": "Thomas David",
    "url": "https://thomasjackdavid.com"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/tjdavid/coralite.git",
    "directory": "packages/coralite"
  },
  "bugs": {
    "url": "https://codeberg.org/tjdavid/coralite/issues"
  },
  "license": "MPL-2.0",
  "scripts": {
    "lint:format": "eslint --cache --fix .",
    "lint": "eslint --cache .",
    "test:unit": "node --conditions=development --experimental-vm-modules --experimental-import-meta-resolve --test \"./tests/unit/**/*.spec.js\"",
    "test:unit:watch": "node --conditions=development --experimental-vm-modules --experimental-import-meta-resolve --test --watch \"./tests/unit/**/*.spec.js\"",
    "test:unit:coverage": "node --conditions=development --experimental-vm-modules --experimental-import-meta-resolve --experimental-test-coverage --test \"./tests/unit/**/*.spec.js\"",
    "test:component:coverage": "node --conditions=development bin/coralite.js validate-components --coverage -c tests/fixtures/components",
    "test:e2e": "pnpm build && pnpm clean:e2e && pnpm build:html:dev && pnpm build:html:prod && pnpm build:html:testing && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "clean:e2e": "premove .coralite-dev && premove .coralite-prod && premove .coralite-testing",
    "server": "pnpm run server:dev",
    "server:dev": "node ./tests/scripts/serve.js --dir .coralite-dev --port 3000",
    "server:prod": "node ./tests/scripts/serve.js --dir .coralite-prod --port 3001",
    "server:testing": "node ./tests/scripts/serve.js --dir .coralite-testing --port 3002",
    "build": "premove dist && pnpm build:lib && pnpm build:types",
    "build:lib": "esbuild ./lib/index.js ./lib/coralite-element.js ./lib/plugin.js ./lib/component-validator.js ./lib/component-fixer.js ./lib/plugin-validator.js ./lib/plugin-fixer.js ./lib/page-validator.js ./lib/utils/core.js ./lib/utils/attributes.js ./lib/utils/index.js ./lib/utils/client/dom.js ./lib/utils/client/inject.js ./lib/utils/client/devtools.js --bundle --target=esnext --format=esm --outdir=dist/lib --platform=node --sourcemap --packages=external --alias:#lib=./lib/index.js --alias:#plugins=./plugins/index.js --outbase=./lib --define:import.meta.env.MODE=import.meta.env.MODE --define:import.meta.env=import.meta.env",
    "build:types": "tsc",
    "build:html:dev": "node --experimental-vm-modules ./tests/scripts/build-html.js --mode development --outDir .coralite-dev",
    "build:html:prod": "node --experimental-vm-modules ./tests/scripts/build-html.js --mode production --outDir .coralite-prod",
    "build:html:testing": "node --experimental-vm-modules ./tests/scripts/build-testing.js",
    "bench": "node --conditions=development --expose-gc --experimental-vm-modules ./benchmarks/runner.js",
    "bench:ci": "node --conditions=development --expose-gc --experimental-vm-modules ./benchmarks/ci.js",
    "bench:save-baseline": "node --conditions=development --expose-gc --experimental-vm-modules ./benchmarks/runner.js --save-baseline"
  },
  "files": [
    "dist",
    "bin",
    "llms.txt"
  ],
  "bin": {
    "coralite": "bin/coralite.js"
  },
  "imports": {
    "#lib": {
      "development": "./lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "#lib/*": {
      "development": "./lib/*",
      "default": "./dist/lib/*"
    },
    "#plugins": "./plugins/index.js",
    "#plugins/*": "./plugins/*"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./component-validator": {
      "types": "./dist/lib/component-validator.d.ts",
      "default": "./dist/lib/component-validator.js"
    },
    "./component-fixer": {
      "types": "./dist/lib/component-fixer.d.ts",
      "default": "./dist/lib/component-fixer.js"
    },
    "./plugin-validator": {
      "types": "./dist/lib/plugin-validator.d.ts",
      "default": "./dist/lib/plugin-validator.js"
    },
    "./plugin-fixer": {
      "types": "./dist/lib/plugin-fixer.d.ts",
      "default": "./dist/lib/plugin-fixer.js"
    },
    "./page-validator": {
      "types": "./dist/lib/page-validator.d.ts",
      "default": "./dist/lib/page-validator.js"
    },
    "./utils": {
      "types": "./dist/lib/utils/index.d.ts",
      "default": "./dist/lib/utils/index.js"
    },
    "./utils/server": {
      "types": "./dist/lib/utils/server/index.d.ts",
      "default": "./dist/lib/utils/server/index.js"
    },
    "./utils/client": {
      "types": "./dist/lib/utils/client/index.d.ts",
      "default": "./dist/lib/utils/client/index.js"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.20.0",
    "@types/serialize-javascript": "^5.0.4",
    "esbuild-svelte": "^0.9.5",
    "happy-dom": "^20.10.6",
    "mitata": "^1.0.34",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sirv": "^3.0.2",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.56.10",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "commander": "^13.1.0",
    "dom-serializer": "^2.0.0",
    "esbuild": "^0.25.12",
    "esbuild-plugins-node-modules-polyfill": "^1.8.1",
    "htmlparser2": "^10.1.0",
    "isomorphic-dompurify": "^3.18.0",
    "kleur": "^4.1.5",
    "p-limit": "^7.3.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.15",
    "postcss-selector-parser": "^7.1.4",
    "serialize-javascript": "^7.0.6",
    "xxhash-wasm": "^1.1.0"
  }
}
